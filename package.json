{
  "name": "create-github-pr",
  "version": "0.1.0",
  "description": "GitHub bot + CLI for creating fully-featured PRs with annotated screenshots, test-case accordions, and staging preview links",
  "main": "src/index.ts",
  "type": "module",
  "bin": {
    "create-github-pr": "src/cli.ts"
  },
  "scripts": {
    "build": "tsc",
    "dev": "bunx tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "bun test",
    "annotate": "bunx tsx src/annotate.ts",
    "pr-body": "bunx tsx src/pr-body.ts",
    "create-pr": "bunx tsx src/cli.ts"
  },
  "keywords": [
    "probot",
    "github-bot",
    "pull-request",
    "screenshots",
    "annotations",
    "devin-skill"
  ],
  "author": "newkub",
  "license": "MIT",
  "dependencies": {
    "probot": "^14.3.2",
    "@octokit/rest": "^22.0.1",
    "@octokit/webhooks": "^14.2.0",
    "playwright": "^1.62.1"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
